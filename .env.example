# Copy to .env.local and fill in. Everything is optional for local development:
# without Supabase keys the app uses a local JSON store (.data/db.json) with demo accounts.

# --- Platform ---
NEXT_PUBLIC_PLATFORM_NAME=Menuly
# Public URL of the platform (emails, QR codes). On Netlify: https://your-site.netlify.app
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Set when you own a domain and want <slug>.yourdomain.com menus (leave empty for /ar/r/<slug> links)
NEXT_PUBLIC_ROOT_DOMAIN=
# Subdomain that serves the dashboard/landing when ROOT_DOMAIN is set
NEXT_PUBLIC_APP_SUBDOMAIN=app
# Extra hostnames to treat as the platform (comma-separated), e.g. a staging domain
PLATFORM_HOSTS=

# Agency WhatsApp number for the landing page buttons (digits only, with country code, e.g. 963912345678).
# Leave empty to hide the WhatsApp buttons.
NEXT_PUBLIC_AGENCY_WHATSAPP=

# --- Local mode only ---
# Set to 1 to allow the demo logins on a writable production server (they're always allowed in
# development and on the read-only Netlify demo).
DEMO_MODE=
# Secret used to sign the demo login cookie (any long random string)
SESSION_SECRET=change-me-to-a-long-random-string

# --- Supabase (production) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Needed for admin actions (create restaurants, invite owners) and the seed script.
SUPABASE_SERVICE_ROLE_KEY=
